# ── Supabase ──────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key        # ⚠ server-only, never expose
SUPABASE_STORAGE_BUCKET=resumes                        # private bucket name

# ── Notifications (Email via Resend) ─────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx              # https://resend.com
NOTIFY_EMAIL_FROM=referrals@yourdomain.com
NOTIFY_EMAIL_TO=shashisa.cse@gmail.com

# ── Notifications (Slack webhook — optional) ─────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# ── Admin (Basic Auth for /referrals/admin) ──────────
AUTH_ADMIN_USER=admin
AUTH_ADMIN_PASS=change-me-strong-password

# ── LLM Configuration (Universal — OpenAI, Groq, OpenRouter, Ollama, Gemini) ─
LLM_API_KEY=your-llm-api-key              # e.g., sk-... or gsk_...
LLM_MODEL=gpt-4o-mini                     # e.g., gpt-4o-mini, llama-3.3-70b-versatile, claude-3-5-haiku
LLM_BASE_URL=https://api.openai.com/v1    # Optional: e.g., https://api.groq.com/openai/v1, https://openrouter.ai/api/v1, http://localhost:11434/v1
GEMINI_API_KEY=your-gemini-key            # Fallback if LLM_API_KEY is not set

# ── AI Features ───────────────────────────────────────
AI_FEATURES_ENABLED=true
AI_RATE_LIMIT_PER_MINUTE=10

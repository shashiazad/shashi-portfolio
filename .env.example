# ── Supabase ──────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key        # ⚠ server-only, never expose
SUPABASE_STORAGE_BUCKET=resumes                        # private bucket name

# ── Notifications (Email via Resend) ─────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx              # https://resend.com
NOTIFY_EMAIL_FROM=referrals@yourdomain.com
NOTIFY_EMAIL_TO=shashisa.cse@gmail.com

# ── Notifications (Slack webhook — optional) ─────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz

# ── Admin (Basic Auth for /referrals/admin) ──────────
AUTH_ADMIN_USER=admin
AUTH_ADMIN_PASS=change-me-strong-password

# ── Existing ──────────────────────────────────────────
GEMINI_API_KEY=your-gemini-key

# ── AI Features ───────────────────────────────────────
AI_FEATURES_ENABLED=true
AI_RATE_LIMIT_PER_MINUTE=10
